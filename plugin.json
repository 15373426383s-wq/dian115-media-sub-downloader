{
  "schema_version": 3,
  "id": "media-sub-downloader",
  "name": "媒体订阅分下载器",
  "author": "swgzy",
  "version": "1.2.2",
  "description": "把 DIAN115 原生媒体订阅按类型自动分配到对应 PT 下载器：电影订阅 → 电影下载器，剧集订阅 → 剧集下载器。直接写入订阅自带的 pt_downloader 字段，由 DIAN115 原生流程扫描 PT 站点并派发下载，插件不自行提交磁力/种子。新增订阅时由 subscribe_added 事件即时同步，另有每 5 分钟兜底。",
  "ui": { "entry": "ui/page.js" },
  "jobs": [
    {
      "id": "sync-downloader",
      "entry": "jobs/sync-downloader.js",
      "handler": "run",
      "recover": "recover",
      "timeout_seconds": 300,
      "allow_overlap": true,
      "title": "同步订阅下载器",
      "default_schedule": "*/5 * * * *"
    }
  ],
  "events": [
    { "event": "host", "job": "sync-downloader", "types": ["subscribe_added"] }
  ],
  "declared_usage": {
    "apis": [
      "GET /api/pt/downloaders",
      "GET /api/subscribe/pool/intents",
      "PATCH /api/subscribe/pool/intents/{id}/preferences"
    ],
    "sites": ["PT 站点（由 DIAN115 原生订阅扫描，插件不直连）"],
    "files": ["插件 data/files 内的同步记录"],
    "notifications": true,
    "risk": "仅写入订阅的 pt_downloader 字段（按类型分配下载器），不读取宿主文件内容，不自行提交下载，不转交 115"
  },
  "requires": { "api": "3.5" },
  "icon": "ui/icon.svg",
  "menu": { "title": "媒体订阅分下载器", "order": 90 }
}
