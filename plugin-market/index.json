{
  "schema_version": 3,
  "repository": {
    "id": "swgzy-dian115-plugins",
    "name": "swgzy 的 DIAN115 插件",
    "homepage": "https://github.com/15373426383s-wq/dian115-media-sub-downloader"
  },
  "plugins": [
    {
      "id": "media-sub-downloader",
      "name": "媒体订阅分下载器",
      "version": "1.2.0",
      "description": "把 DIAN115 原生媒体订阅按电影/剧集类型自动分配到对应 PT 下载器：直接写入订阅的 pt_downloader 字段，由 DIAN115 原生流程扫描 PT 站点并派发下载，插件不自行提交。定时或手动同步，新增订阅自动按类型分配。源码零凭据。",
      "author": "swgzy",
      "source_url": "https://github.com/15373426383s-wq/dian115-media-sub-downloader/releases/download/v1.2.0/media-sub-downloader.dian115p",
      "sha256": "7e1567b948abfb52b525aa6ef99d65e5435fb234dcd4d668e3626d2e55a7e7fa",
      "delivery": "source",
      "declared_usage": {
        "apis": [
          "GET /api/pt/downloaders",
          "GET /api/subscribe/pool/intents",
          "PATCH /api/subscribe/pool/intents/{id}/preferences"
        ],
        "network": ["PT 站点（由 DIAN115 原生订阅扫描，插件不直连）"],
        "files": ["插件 data/files 内的同步记录"],
        "notifications": true,
        "risk": "仅写入订阅的 pt_downloader 字段（按类型分配下载器），不读取宿主文件内容，不自行提交下载，不转交 115"
      }
    }
  ]
}
